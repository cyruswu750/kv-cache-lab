# Environments (a .venv symlink to an existing environment is not a directory to git: ignore it too)
.venv/
.venv
__pycache__/
*.pyc
.pytest_cache/

# Model weights / HF cache (project-local, never committed)
.hf_cache/
*.safetensors
*.bin
*.pt

# Large generated tensors
results/**/*.pt
results/**/*.npy

# M5 output directories, written while a stage runs (docs/M5_PROTOCOL_DRAFT.md §11 item 6). They are ignored so
# that a running stage's own outputs do not appear in the source state its sessions record. The executed
# evidence in them is committed explicitly (decision D44).
/results/m5/M5_CAL_V1_run/
/results/m5/M5_FIT_V1/
/results/m5/M5_EVAL_V1_run/
/results/m5/M5_EVAL_V1_analysis/

# Secrets / machine-specific
.env
*.token

# Windows download metadata
*:Zone.Identifier

# Local pre-edit snapshots (not for git)
backups/

# Project-owned disk KV cache payloads (never committed)
.kvcache/

# Local working notes (not part of the project)
/CLAUDE.md
/kv-cache-plan.md
/docs/*_REVIEW.md
/docs/*_WALKTHROUGH.md
/docs/*_HANDOFF.md
/local/
