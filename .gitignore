# Environments (a .venv symlink to an existing environment is not a directory to git: ignore it too)
.venv/
.venv
__pycache__/
*.pyc
.pytest_cache/

# Model weights / HF cache (project-local, never committed)
.hf_cache/
*.safetensors
*.bin
*.pt

# Large generated tensors
results/**/*.pt
results/**/*.npy

# Secrets / machine-specific
.env
*.token

# Windows download metadata
*:Zone.Identifier

# Local pre-edit snapshots (not for git)
backups/

# Project-owned disk KV cache payloads (never committed)
.kvcache/

# Local-only working documents (kept on disk, not published): agent instructions,
# the original working plan, milestone reviews/handoffs and walkthroughs.
/CLAUDE.md
/kv-cache-plan.md
/docs/*_REVIEW.md
/docs/*_WALKTHROUGH.md
/docs/*_HANDOFF.md
# Local notes, backups and handoff material
/local/
